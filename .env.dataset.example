# Dataset Collection Configuration

# Enable dataset collection (default: false)
DATASET_ENABLED=false

# Path to Google OAuth2 credentials JSON file
# Download from: https://console.cloud.google.com/apis/credentials
DATASET_GOOGLE_DRIVE_CREDENTIALS=./backend/credentials/google_drive_credentials.json

# Google Drive folder ID where dataset files will be uploaded
# Create a folder in Google Drive and copy its ID from the URL:
# https://drive.google.com/drive/folders/<FOLDER_ID>
DATASET_GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Number of conversations per batch before upload (default: 100)
DATASET_BATCH_SIZE=100

# Maximum batch size in MB before upload (default: 10)
DATASET_BATCH_MAX_MB=10

# Batch upload interval in seconds (default: 300 = 5 minutes)
DATASET_BATCH_INTERVAL_SEC=300

# Maximum items in memory buffer before dropping old entries (default: 1000)
DATASET_BUFFER_MAX_ITEMS=1000
