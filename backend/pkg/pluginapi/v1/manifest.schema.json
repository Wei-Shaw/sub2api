{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2api.local/schemas/plugin-manifest-v1.json",
  "title": "Sub2API Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "requires", "capabilities", "runtimes", "ui", "files"],
  "properties": {
    "schema_version": { "const": 1 REDACTED,
    "id": { "type": "string", "maxLength": 160, "pattern": "^[a-z0-9]+([._-][a-z0-9]+)+$" REDACTED,
    "name": { "type": "string", "minLength": 1, "maxLength": 160 REDACTED,
    "version": { "type": "string", "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$" REDACTED,
    "description": { "type": "string" REDACTED,
    "author": { "type": "string", "maxLength": 160 REDACTED,
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sub2api", "plugin_protocol", "transport_api", "ui_bridge"],
      "properties": {
        "sub2api": { "type": "string", "minLength": 1 REDACTED,
        "recommended_sub2api_version": { "type": "string" REDACTED,
        "tested_sub2api_versions": { "type": "array", "items": { "type": "string" REDACTED, "uniqueItems": true REDACTED,
        "plugin_protocol": { "const": 1 REDACTED,
        "transport_api": { "const": 1 REDACTED,
        "ui_bridge": { "const": 1 REDACTED
      REDACTED
    REDACTED,
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "account_type"],
        "properties": {
          "id": { "const": "openai.oauth.outbound_transport.v1" REDACTED,
          "platform": { "const": "openai" REDACTED,
          "account_type": { "const": "oauth" REDACTED
        REDACTED
      REDACTED
    REDACTED,
    "runtimes": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9]+-[a-z0-9]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": { "path": { "$ref": "#/$defs/safePath" REDACTED REDACTED
        REDACTED
      REDACTED,
      "additionalProperties": false
    REDACTED,
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint"],
      "properties": { "entrypoint": { "type": "string", "pattern": "^ui/.+" REDACTED REDACTED
    REDACTED,
    "files": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": { "$ref": "#/$defs/safePath" REDACTED,
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64REDACTED$" REDACTED
    REDACTED
  REDACTED,
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    REDACTED
  REDACTED
REDACTED
