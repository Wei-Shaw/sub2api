# Sub2API 外部 PostgreSQL/Redis 部署模板
# 复制为 .env 后填写真实密码和密钥：
#   Copy-Item .env.example .env
#
# 启动命令：
#   docker compose --env-file .env -f docker-compose.standalone.yml up -d

BIND_HOST=0.0.0.0
SERVER_PORT=9010
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

# PostgreSQL：建议使用独立数据库，不要和 Superset 共用业务表
DATABASE_HOST=192.168.0.102
DATABASE_PORT=5432
DATABASE_USER=superset
DATABASE_PASSWORD=change_this_database_password
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# Redis：使用独立逻辑库，避免和其它服务共用键空间
REDIS_HOST=192.168.0.102
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=10
REDIS_ENABLE_TLS=false

# 首次启动时自动创建管理员
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# 固定密钥，避免重启后 JWT 和 TOTP 失效
# 可使用 openssl rand -hex 32 生成
JWT_SECRET=
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=

# 首次启动自动执行数据库迁移
AUTO_SETUP=true
SETUP_MIGRATION_TIMEOUT_SECONDS=120

# 当前不使用 OAuth；后续接入 Gemini OAuth 时再补充
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_SCOPES=
GEMINI_QUOTA_POLICY=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_USER_AGENT_VERSION=
