# =============================================================================
# Sub2API Host-Network Deployment Environment
# =============================================================================
# For deploy/docker-compose.host-network.yml only.
# This file is intentionally separate from deploy/.env.example so the original
# deployment template stays unchanged.
# =============================================================================

# Prebuilt image reference.
# Example:
# SUB2API_IMAGE=ghcr.io/your-github-owner/sub2api:latest
SUB2API_IMAGE=

TZ=Asia/Shanghai
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_PASSWORD=change_this_database_password
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLE_TLS=false

ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=

# Optional CORS settings for direct browser access
# Comma-separated, for example:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# Optional proxy settings
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# Cloudflare Tunnel token
TUNNEL_TOKEN=
