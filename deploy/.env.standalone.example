# =============================================================================
# Sub2API Standalone App Node Environment Example
# =============================================================================
# Use this on an additional Sub2API application server, for example
# 43.155.229.90. This node runs only Sub2API and connects to PostgreSQL/Redis
# on the existing primary server.
#
# Copy to .env and replace every CHANGE_ME / primary-private-ip value.
# Do not commit the real .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# App listener
# -----------------------------------------------------------------------------
BIND_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# Shared PostgreSQL on the primary server
# -----------------------------------------------------------------------------
# Use the primary server private/VPN IP. Avoid public Internet exposure.
DATABASE_HOST=primary-private-ip
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_PASSWORD=CHANGE_ME_COPY_FROM_PRIMARY_POSTGRES_PASSWORD
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable

# Keep the sum of all app nodes' max_open_conns below PostgreSQL max_connections.
# For two app nodes, 64-128 per node is usually a safer starting point than 256.
DATABASE_MAX_OPEN_CONNS=128
DATABASE_MAX_IDLE_CONNS=32
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# -----------------------------------------------------------------------------
# Shared Redis on the primary server
# -----------------------------------------------------------------------------
REDIS_HOST=primary-private-ip
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_COPY_FROM_PRIMARY_REDIS_PASSWORD
REDIS_DB=0
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=64
REDIS_ENABLE_TLS=false

# -----------------------------------------------------------------------------
# Shared secrets: must match the primary server exactly
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_COPY_FROM_PRIMARY_JWT_SECRET
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=CHANGE_ME_COPY_FROM_PRIMARY_TOTP_ENCRYPTION_KEY

# -----------------------------------------------------------------------------
# Admin account
# -----------------------------------------------------------------------------
# These are only used for first-time auto-setup. Existing databases already have
# the admin user, so keep them consistent but do not rely on them for updates.
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# OAuth / upstream optional secrets: copy from the primary server if used
# -----------------------------------------------------------------------------
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_SCOPES=
GEMINI_QUOTA_POLICY=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_USER_AGENT_VERSION=

# -----------------------------------------------------------------------------
# Gateway defaults
# -----------------------------------------------------------------------------
GATEWAY_OPENAI_RESPONSE_HEADER_TIMEOUT=0
GATEWAY_OPENAI_HTTP2_ENABLED=true
GATEWAY_OPENAI_HTTP2_ALLOW_PROXY_FALLBACK_TO_HTTP1=true
GATEWAY_OPENAI_HTTP2_FALLBACK_ERROR_THRESHOLD=2
GATEWAY_OPENAI_HTTP2_FALLBACK_WINDOW_SECONDS=60
GATEWAY_OPENAI_HTTP2_FALLBACK_TTL_SECONDS=600
GATEWAY_IMAGE_STREAM_DATA_INTERVAL_TIMEOUT=900
GATEWAY_IMAGE_STREAM_KEEPALIVE_INTERVAL=10
GATEWAY_IMAGE_CONCURRENCY_ENABLED=false
GATEWAY_IMAGE_CONCURRENCY_MAX_CONCURRENT_REQUESTS=0
GATEWAY_IMAGE_CONCURRENCY_OVERFLOW_MODE=reject
GATEWAY_IMAGE_CONCURRENCY_WAIT_TIMEOUT_SECONDS=30
GATEWAY_IMAGE_CONCURRENCY_MAX_WAITING_REQUESTS=100
