# Local Sub2API test deployment.
# Copy to .env before starting:
#   cp .env.example .env

BIND_HOST=127.0.0.1
SERVER_PORT=18080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Singapore

# Keep local test deployments aligned with the confirmed production Sub2API version.
SUB2API_IMAGE=weishaw/sub2api:v0.1.144

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=sub2api

REDIS_PASSWORD=
REDIS_DB=0

ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=

# Generate fixed local secrets before serious testing:
#   openssl rand -hex 32
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
