# 自有部署示例，复制为 .env 后填写；不要提交真实凭据。
# 使用完整的自有发布标签，例如 v0.2.23-custom.1；此处留空以防误用。
SUB2API_IMAGE=ghcr.io/wklong/sub2api
SUB2API_VERSION=
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:18-alpine
REDIS_IMAGE=docker.m.daocloud.io/library/redis:8-alpine

# 项目名决定命名卷名称，首次部署后不要随意修改。
COMPOSE_PROJECT_NAME=sub2api-custom
# 默认仅本机访问，配合反向代理；需要直连时改为实际监听地址。
BIND_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_MODE=release
TZ=Asia/Shanghai

POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 分别执行 openssl rand -hex 32 生成以上密码及以下两个固定密钥。
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

# 仅首次初始化生效；密码至少 8 字节，不超过 72 字节。
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 可选项沿用 ../docker-compose.yml 中的环境变量，完整示例见 ../.env.example。
RUN_MODE=standard
MCP_PUBLIC_URL=
