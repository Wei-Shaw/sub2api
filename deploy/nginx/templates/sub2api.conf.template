# =============================================================================
# Sub2API Nginx Reverse Proxy
# =============================================================================
# Rendered into /etc/nginx/conf.d/ by the official nginx image entrypoint. The
# DOMAIN placeholder is substituted from the environment; every other $variable
# is an nginx runtime variable and survives because docker-compose.local.yml
# sets NGINX_ENVSUBST_FILTER to match the DOMAIN name only.
#
# Only IPv4 is listened on: Docker publishes the ports on the host and proxies
# inbound IPv6 traffic to the container over IPv4, so an explicit [::] listener
# would be redundant and fails on daemons without IPv6 enabled.
# =============================================================================

# "Connection: upgrade" for WebSocket requests, and an empty value otherwise so
# nginx sends no Connection header at all — HTTP/1.1 then defaults to a
# persistent connection, which is what makes the upstream keepalive pool below
# actually get reused. (Mapping to "close" here would disable it.)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      "";
}

upstream sub2api_backend {
    server aibridge:8080;
    keepalive 64;
}

# -----------------------------------------------------------------------------
# HTTP -> HTTPS redirect
# -----------------------------------------------------------------------------
server {
    # default_server makes this block win over the image's bundled default.conf
    # (server_name localhost), so requests sent straight to the server IP land
    # here instead of on the Nginx welcome page.
    listen 80 default_server;
    server_name ${DOMAIN};

    return 301 https://$host$request_uri;
}

# -----------------------------------------------------------------------------
# HTTPS
# -----------------------------------------------------------------------------
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 256m;

    # Long timeouts and disabled buffering keep streaming (SSE) responses from
    # being cut off or batched by the proxy.
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    proxy_buffering    off;

    # Hashed build artifacts are immutable and safe to cache indefinitely.
    location ~ ^/(assets/|logo\.png$|favicon\.ico$) {
        proxy_pass http://sub2api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Connection "";

        # add_header in a location replaces the server-level set, so HSTS is
        # repeated here.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    location / {
        proxy_pass http://sub2api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
