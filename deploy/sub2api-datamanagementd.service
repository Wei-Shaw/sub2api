[Unit]
Description=AI2API Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=ai2api
Group=ai2api
WorkingDirectory=/opt/ai2api
ExecStart=/opt/ai2api/datamanagementd \
  -socket-path /tmp/ai2api-datamanagement.sock \
  -sqlite-path /var/lib/ai2api/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
