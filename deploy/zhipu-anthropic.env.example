# Claude Code -> Sub2API -> Zhipu client configuration.
# Copy this file to client.env and replace the placeholder with a Sub2API
# downstream API key. Never put the Zhipu upstream token here.

ANTHROPIC_BASE_URL=http://127.0.0.1:8080
ANTHROPIC_AUTH_TOKEN=<SUB2API_DOWNSTREAM_API_KEY>

ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.7
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.2[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.2[1m]

# Recommended for current Claude Code releases when using compatible providers.
ENABLE_TOOL_SEARCH=0
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
