# ── Sub2API OIDC demo configuration ────────────────────────────────────────
# Copy to ".env" and fill in. The server loads ".env" automatically on start.

# Issuer URL of your Sub2API instance (no trailing slash).
SUB2API_ISSUER_URL=https://api.example.com

# Client credentials registered on the Sub2API admin OIDC clients page.
SUB2API_CLIENT_ID=rp_xxxxxxxx
SUB2API_CLIENT_SECRET=secret_xxxxxxxx

# Must match a registered redirect URI byte-for-byte.
SUB2API_REDIRECT_URI=http://localhost:3000/callback

# Space-separated scopes. "openid" is mandatory; "offline_access" enables refresh.
# Add "sub2api:apikey" to see the UserInfo-only claim.
SUB2API_SCOPES=openid profile email offline_access

# Local server port (must match the port in SUB2API_REDIRECT_URI).
PORT=3000
