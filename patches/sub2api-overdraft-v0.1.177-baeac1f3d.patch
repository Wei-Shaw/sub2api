+  sub2api:
+    image: sub2api-overdraft:local
+    build:
+      context: ..
+      dockerfile: Dockerfile
+      args:
+        # Keep this empty so source builds always read the tracked FORK_VERSION.
+        # This avoids unrelated host BUILD_VERSION values overriding the Fork version.
+        VERSION: ""
+        COMMIT: ${BUILD_COMMIT:-local}
+        BUILD_TYPE: source
