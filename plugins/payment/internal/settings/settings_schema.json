{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Payment",
  "type": "object",
  "properties": {
    "enabled": {"type": "boolean", "default": false, "title": "Enable payment"},
    "min_recharge_amount": {"type": "number", "default": 1, "minimum": 0},
    "max_recharge_amount": {"type": "number", "default": 0},
    "daily_recharge_limit": {"type": "number", "default": 0},
    "order_timeout_minutes": {"type": "integer", "default": 5, "minimum": 1},
    "max_pending_orders": {"type": "integer", "default": 3, "minimum": 1},
    "enabled_payment_types": {"type": "array", "items": {"type": "string"}, "default": ["alipay", "wxpay"]},
    "load_balance_strategy": {"type": "string", "enum": ["round-robin", "least-amount"], "default": "round-robin"},
    "balance_payment_disabled": {"type": "boolean", "default": false},
    "balance_recharge_multiplier": {"type": "number", "default": 1, "minimum": 0},
    "recharge_fee_rate": {"type": "number", "default": 0, "minimum": 0, "maximum": 1},
    "product_name_prefix": {"type": "string", "default": ""},
    "product_name_suffix": {"type": "string", "default": ""},
    "help_image_url": {"type": "string", "default": ""},
    "help_text": {"type": "string", "default": ""},
    "cancel_rate_limit_enabled": {"type": "boolean", "default": false},
    "cancel_rate_limit_max": {"type": "integer", "default": 5},
    "cancel_rate_limit_window": {"type": "integer", "default": 1},
    "cancel_rate_limit_unit": {"type": "string", "enum": ["minute", "hour", "day"], "default": "hour"},
    "cancel_rate_limit_window_mode": {"type": "string", "enum": ["rolling", "fixed"], "default": "rolling"},
    "visible_method_alipay_source": {"type": "string", "default": "official"},
    "visible_method_wxpay_source": {"type": "string", "default": "official"},
    "visible_method_alipay_enabled": {"type": "boolean", "default": true},
    "visible_method_wxpay_enabled": {"type": "boolean", "default": true},
    "resume_signing_key_hex": {"type": "string", "default": "", "x-visibility": "secret"}
  }
}
