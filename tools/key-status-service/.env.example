# Random secret used by desktop clients. Generate with: openssl rand -hex 32
KEY_STATUS_API_TOKEN=replace_with_random_token

# PostgreSQL connection for the Sub2API database.
# If deployed in the same Docker Compose network as Sub2API, DATABASE_HOST is usually postgres.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=sub2api
DATABASE_USER=sub2api
DATABASE_PASSWORD=replace_with_sub2api_postgres_password

# Optional: restrict lookups to one Sub2API account email.
# Leave blank to allow exact-key lookup across all users in that Sub2API instance.
SUB2API_ACCOUNT_EMAIL=admin@sub2api.local
